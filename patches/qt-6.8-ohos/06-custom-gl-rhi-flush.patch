+QPlatformBackingStore::FlushResult QOhosPlatformBackingStoreGL::rhiFlush(
+    QWindow *targetWindow, qreal sourceDevicePixelRatio,
+    const QRegion &region, const QPoint &offset,
+    QPlatformTextureList *textures, bool translucentBackground)
+{
+    Q_UNUSED(sourceDevicePixelRatio);
+    Q_UNUSED(region);
+    Q_UNUSED(offset);
+    Q_UNUSED(translucentBackground);
+
+    // This backing store deliberately does not create QPlatformBackingStore's
+    // QRhi support.  The base implementation would index an empty RHI state
+    // and enter QBackingStoreDefaultCompositor with a null pipeline.
+    if (targetWindow == nullptr || textures == nullptr || !m_framebuffer || !m_glContext)
+        return FlushFailed;
+
+    auto optTarget = RenderContextData::tryCreateForQWindow(targetWindow);
+    if (!optTarget.hasValue())
+        return FlushFailed;
+    const auto target = optTarget.value();
+
+    if (!m_glContext->makeCurrent(target.qWindow) || !hasUsableCurrentContext(*m_glContext))
+        return FlushFailed;
+
+    const QSize targetSize = target.unscaledWindowGeometry.size();
+    if (!targetSize.isValid() || targetSize.isEmpty())
+        return FlushFailed;
+
+    if (!m_blitter) {
+        m_blitter = std::make_unique<QOpenGLTextureBlitter>();
+        if (!m_blitter->create()) {
+            m_blitter.reset();
+            return FlushFailed;
+        }
+    }
+    if (!m_blitter->isCreated())
+        return FlushFailed;
+
+    m_framebuffer->release();
+    setViewportAndClearColorBuffer(*m_glContext, targetSize, QColor(Qt::transparent));
+
+    const QRect targetWindowRect(QPoint(), targetSize);
+    auto *functions = m_glContext->functions();
+    functions->glDisable(GL_BLEND);
+    m_blitter->bind();
+    blitTextureList(*m_blitter, *textures, targetWindowRect);
+
+    // The raster backing store is the middle layer in Qt's normal OpenGL
+    // compositor.  Keep alpha enabled so the QOpenGLWidget view remains
+    // visible through its transparent hole.
+    functions->glEnable(GL_BLEND);
+    functions->glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    m_blitter->setOpacity(1.0f);
+    m_blitter->blit(
+        m_framebuffer->texture(),
+        QOpenGLTextureBlitter::targetTransform(targetWindowRect, targetWindowRect),
+        QOpenGLTextureBlitter::OriginBottomLeft);
+    m_blitter->release();
+    functions->glDisable(GL_BLEND);
+
+    m_glContext->swapBuffers(target.qWindow);
+    return FlushSuccess;
+}
