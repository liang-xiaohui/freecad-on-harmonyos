+QRect toBottomLeftRect(const QRect &topLeftRect, int sourceHeight)
+{
+    return QRect(topLeftRect.x(), sourceHeight - topLeftRect.bottom() - 1,
+                 topLeftRect.width(), topLeftRect.height());
+}
+
+bool hasUsableCurrentContext(QOpenGLContext &context)
+{
+    if (QOpenGLContext::currentContext() != &context)
+        return false;
+
+    auto *functions = context.functions();
+    if (functions == nullptr)
+        return false;
+
+    // OHOS can report a valid QOpenGLContext while the OpenGL wrapper has not
+    // installed the per-context entry points yet.  Do not let Qt's generic
+    // QRhi path touch that state: it assumes a non-null pipeline and crashes
+    // in QPlatformBackingStore::rhiFlush().
+    return functions->glGetString(GL_VERSION) != nullptr;
+}
+
+void blitTextureList(
+    QOpenGLTextureBlitter &blitter,
+    const QPlatformTextureList &textures,
+    const QRect &targetWindowRect)
+{
+    auto blitTexture = [&](int index) {
+        auto *texture = textures.texture(index);
+        if (texture == nullptr)
+            return;
+
+        const GLuint textureId = static_cast<GLuint>(texture->nativeTexture().object);
+        if (textureId == 0)
+            return;
+
+        const QRect rectInWindow = textures.geometry(index);
+        if (!rectInWindow.isValid() || rectInWindow.isEmpty())
+            return;
+
+        QRect clipRect = textures.clipRect(index);
+        if (clipRect.isEmpty())
+            clipRect = QRect(QPoint(), rectInWindow.size());
+        clipRect = clipRect.intersected(QRect(QPoint(), rectInWindow.size()));
+        if (clipRect.isEmpty())
+            return;
+
+        const QRect clippedRectInWindow = rectInWindow & clipRect.translated(rectInWindow.topLeft());
+        if (clippedRectInWindow.isEmpty())
+            return;
+
+        const QRect sourceRect = toBottomLeftRect(clipRect, rectInWindow.height());
+        const QMatrix4x4 target = QOpenGLTextureBlitter::targetTransform(
+            clippedRectInWindow, targetWindowRect);
+        const QMatrix3x3 source = QOpenGLTextureBlitter::sourceTransform(
+            sourceRect, rectInWindow.size(), QOpenGLTextureBlitter::OriginBottomLeft);
+        blitter.blit(textureId, target, source);
+    };
+
+    // Match Qt's OpenGL compositor ordering: ordinary widget textures first,
+    // the raster backing store in the middle, and StacksOnTop textures last.
+    for (int i = 0; i < textures.count(); ++i) {
+        if (!textures.flags(i).testFlag(QPlatformTextureList::StacksOnTop))
+            blitTexture(i);
+    }
+    for (int i = 0; i < textures.count(); ++i) {
+        if (textures.flags(i).testFlag(QPlatformTextureList::StacksOnTop))
+            blitTexture(i);
+    }
+}
