+    if (wsiEvent.pressedButtonsKnown || wsiEvent.cancelled) {
+        // MouseButtonStateRecovery: ArkUI's complete post-event state repairs
+        // a lost release or press without surfacing a warning to applications.
+        const Qt::MouseButtons reportedButtons =
+            wsiEvent.cancelled ? Qt::MouseButtons(Qt::NoButton) : wsiEvent.pressedButtons;
+        Qt::MouseButtons missingReleases = m_mouseButtonsState & ~reportedButtons;
+        Qt::MouseButtons missingPresses = reportedButtons & ~m_mouseButtonsState;
+
+        if (wsiEvent.eventType == QEvent::MouseButtonRelease) {
+            missingReleases.setFlag(wsiEvent.button, false);
+        } else if (wsiEvent.eventType == QEvent::MouseButtonPress) {
+            missingPresses.setFlag(wsiEvent.button, false);
+        }
+
+        auto dispatchMissingTransition = [&](Qt::MouseButton changedButton, QEvent::Type type) {
+            QOhosMouseEvent recoveredEvent = mouseEvent;
+            recoveredEvent.button = changedButton;
+            recoveredEvent.eventType = type;
+            recoveredEvent.pressedButtonsKnown = false;
+            recoveredEvent.cancelled = false;
+            onMouseEvent(recoveredEvent);
+        };
+        for (const auto trackedButton : trackedMouseButtons) {
+            if (missingReleases.testFlag(trackedButton)) {
+                dispatchMissingTransition(trackedButton, QEvent::MouseButtonRelease);
+            }
+        }
+        for (const auto trackedButton : trackedMouseButtons) {
+            if (missingPresses.testFlag(trackedButton)) {
+                dispatchMissingTransition(trackedButton, QEvent::MouseButtonPress);
+            }
+        }
+    }
+
+    if (wsiEvent.cancelled) {
+        return;
+    }
+
     handleMouseEvent(wsiEvent);
