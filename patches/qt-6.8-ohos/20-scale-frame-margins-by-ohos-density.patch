     if (decorationPreset() == DecorationPreset::Standard) {
+        // The window manager states this height in vp, so it has to be scaled by the
+        // OHOS screen density to reach native pixels. Do not use
+        // QPlatformScreen::devicePixelRatio() here: this QPA does not override it,
+        // so it stays at Qt's default of 1.0 and leaves the margin unscaled. Every
+        // decorated OHOS SubWindow then requested a windowRect that was one title bar
+        // too short, and the system takes the missing pixels out of the client area,
+        // so small dialogs (QInputDialog and friends) came up with clipped contents.
         // https://gitlab.siilicloud.com/automotive/customers/qt/qt-for-openharmony/ohos-mirrors/ohos-window-manager/utils/include/wm_common_inner.h
         constexpr auto predefinedWindowTitleBarHeight = 37;
-        const int titlebarHeightPixels = std::round(predefinedWindowTitleBarHeight * screen->devicePixelRatio());
+        const qreal screenDensity = screen->pixelDensity() > 0 ? screen->pixelDensity() : 1.0;
+        const int titlebarHeightPixels = std::round(predefinedWindowTitleBarHeight * screenDensity);
         return QMargins{0, titlebarHeightPixels, 0, 0};
     }
 
