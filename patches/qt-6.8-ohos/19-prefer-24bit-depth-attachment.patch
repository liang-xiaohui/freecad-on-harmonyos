+// OHOS: keep the depth attachment as wide as the driver can actually provide.
+// GLES2 core only guarantees GL_DEPTH_COMPONENT16, and a driver is not obliged
+// to advertise GL_OES_depth24 even when it happily accepts a 24-bit
+// renderbuffer. A 16-bit depth buffer cannot resolve the sub-millimetre
+// distance between the (near-)coincident faces that CAD models routinely
+// contain, so the two surfaces win the depth test per pixel and the overlap
+// shows up as z-fighting stripes. Ask for 24-bit first and fall back to the
+// 16-bit core format only when the driver rejects the request or hands back
+// fewer than 24 bits.
+//
+// The verdict comes from GL_RENDERBUFFER_DEPTH_SIZE rather than glGetError():
+// an ES2 driver may accept GL_DEPTH_COMPONENT24 without raising an error and
+// still allocate 16 bits, which would leave the artifact in place while a pure
+// error check reported success.
+static GLenum reserveRenderbufferStorage(QOpenGLExtensions &funcs, bool multisample,
+                                         int samples, GLenum preferred, GLenum fallback,
+                                         const QSize &size)
+{
+    const auto drainErrors = [&]() {
+        while (funcs.glGetError() != GL_NO_ERROR) {
+        }
+    };
+    const auto store = [&](GLenum internalFormat) {
+        drainErrors();
+        if (multisample)
+            funcs.glRenderbufferStorageMultisample(GL_RENDERBUFFER, samples, internalFormat,
+                                                   size.width(), size.height());
+        else
+            funcs.glRenderbufferStorage(GL_RENDERBUFFER, internalFormat,
+                                        size.width(), size.height());
+        return funcs.glGetError() == GL_NO_ERROR;
+    };
+    const auto allocatedDepthBits = [&]() {
+        GLint bits = -1;
+        funcs.glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_DEPTH_SIZE, &bits);
+        return int(bits);
+    };
+
+    GLenum used = preferred;
+    const bool accepted = store(preferred);
+    int bits = accepted ? allocatedDepthBits() : -1;
+    const bool fellBack = !accepted || bits < 24;
+    if (fellBack) {
+        used = fallback;
+        if (store(fallback))
+            bits = allocatedDepthBits();
+    }
+
+    {
+        static int reportedDepth = 0;
+        if (reportedDepth < 8) {
+            ++reportedDepth;
+            QOpenGLContext *ctx = QOpenGLContext::currentContext();
+            qWarning("OHOS-DEPTH: wanted=0x%x accepted=%d used=0x%x actualBits=%d "
+                     "multisample=%d samples=%d size=%dx%d es=%d fmt=%d.%d "
+                     "packedDS=%d depth24Ext=%d",
+                     int(preferred), accepted ? 1 : 0, int(used), bits,
+                     multisample ? 1 : 0, samples, size.width(), size.height(),
+                     ctx && ctx->isOpenGLES() ? 1 : 0,
+                     ctx ? ctx->format().majorVersion() : -1,
+                     ctx ? ctx->format().minorVersion() : -1,
+                     funcs.hasOpenGLExtension(QOpenGLExtensions::PackedDepthStencil) ? 1 : 0,
+                     funcs.hasOpenGLExtension(QOpenGLExtensions::Depth24) ? 1 : 0);
+        }
+    }
+    if (fellBack) {
+        static bool warnedDepthFallback = false;
+        if (!warnedDepthFallback) {
+            warnedDepthFallback = true;
+            qWarning("OHOS: 0x%x depth renderbuffer unavailable, using 0x%x "
+                     "(expect depth-precision artifacts)",
+                     int(preferred), int(fallback));
+        }
+    }
+    return used;
+}
