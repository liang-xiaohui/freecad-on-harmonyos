--- a/src/gl/sketch_diag.h
+++ b/src/gl/sketch_diag.h
@@ -0,0 +1,177 @@
+#ifndef _GL4ES_SKETCH_DIAG_H_
+#define _GL4ES_SKETCH_DIAG_H_
+
+/* Narrow instrumentation for the FreeCAD Sketcher rendering investigation. */
+#if defined(FREECAD_OHOS_SKETCH_DIAG)
+
+#include "gles.h"
+#include "loader.h"
+#include "logs.h"
+
+static unsigned int freecad_sketch_diag_budget = 30000;
+
+static inline void freecad_sketch_diag_drain(const char *site)
+{
+    if (freecad_sketch_diag_budget == 0)
+        return;
+    LOAD_GLES(glGetError);
+    GLenum error;
+    unsigned int drained = 0;
+    while ((error = gles_glGetError()) != GL_NO_ERROR && drained < 8) {
+        LOGD("SKETCH_DIAG native-error %s error=0x%04x\n", site, error);
+        ++drained;
+        --freecad_sketch_diag_budget;
+    }
+}
+
+static inline void freecad_sketch_diag_before(const char *site)
+{
+    if (freecad_sketch_diag_budget == 0)
+        return;
+    --freecad_sketch_diag_budget;
+    LOGD("SKETCH_DIAG before %s\n", site);
+    freecad_sketch_diag_drain(site);
+}
+
+static inline void freecad_sketch_diag_after(const char *site)
+{
+    if (freecad_sketch_diag_budget == 0)
+        return;
+    LOAD_GLES(glGetError);
+    GLenum error = gles_glGetError();
+    if (error != GL_NO_ERROR) {
+        LOGD("SKETCH_DIAG after %s error=0x%04x\n", site, error);
+        --freecad_sketch_diag_budget;
+    }
+}
+
+static inline void freecad_sketch_diag_state(const char *site, GLfloat a,
+                                             GLfloat b, GLfloat c, GLfloat d)
+{
+    if (freecad_sketch_diag_budget == 0)
+        return;
+    --freecad_sketch_diag_budget;
+    LOGD("SKETCH_DIAG state %s values=%.4f,%.4f,%.4f,%.4f\n",
+         site, a, b, c, d);
+}
+
+static inline void freecad_sketch_diag_tex_image2d(
+    const char *file, int line, GLenum target, GLint level, GLint internalformat,
+    GLsizei width, GLsizei height, GLint border, GLenum format, GLenum type,
+    const GLvoid *data)
+{
+    LOAD_GLES(glTexImage2D);
+    freecad_sketch_diag_before("glTexImage2D");
+    if (freecad_sketch_diag_budget > 0)
+        LOGD("SKETCH_DIAG teximage %s:%d target=0x%04x level=%d size=%dx%d "
+             "internal=0x%04x format=0x%04x type=0x%04x data=%p\n",
+             file, line, target, level, width, height, internalformat, format,
+             type, data);
+    gles_glTexImage2D(target, level, internalformat, width, height, border,
+                      format, type, data);
+    freecad_sketch_diag_after("glTexImage2D");
+}
+
+static inline void freecad_sketch_diag_tex_sub_image2d(
+    const char *file, int line, GLenum target, GLint level, GLint xoffset,
+    GLint yoffset, GLsizei width, GLsizei height, GLenum format, GLenum type,
+    const GLvoid *data)
+{
+    LOAD_GLES(glTexSubImage2D);
+    freecad_sketch_diag_before("glTexSubImage2D");
+    if (freecad_sketch_diag_budget > 0)
+        LOGD("SKETCH_DIAG texsub %s:%d target=0x%04x level=%d xy=%d,%d "
+             "size=%dx%d format=0x%04x type=0x%04x data=%p\n",
+             file, line, target, level, xoffset, yoffset, width, height,
+             format, type, data);
+    gles_glTexSubImage2D(target, level, xoffset, yoffset, width, height,
+                         format, type, data);
+    freecad_sketch_diag_after("glTexSubImage2D");
+}
+
+static inline void freecad_sketch_diag_draw_arrays(
+    const char *file, int line, GLenum mode, GLint first, GLsizei count)
+{
+    LOAD_GLES(glDrawArrays);
+    freecad_sketch_diag_before("glDrawArrays");
+    if (freecad_sketch_diag_budget > 0) {
+        LOAD_GLES(glGetIntegerv);
+        LOAD_GLES(glIsEnabled);
+        GLint program = 0;
+        GLint viewport[4] = {0, 0, 0, 0};
+        GLint scissor[4] = {0, 0, 0, 0};
+        gles_glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+        gles_glGetIntegerv(GL_VIEWPORT, viewport);
+        gles_glGetIntegerv(GL_SCISSOR_BOX, scissor);
+        LOGD("SKETCH_DIAG draw %s:%d mode=0x%04x first=%d count=%d program=%d "
+             "blend=%d depth=%d scissor=%d box=%d,%d,%d,%d "
+             "viewport=%d,%d,%d,%d\n",
+             file, line, mode, first, count, program,
+             gles_glIsEnabled(GL_BLEND), gles_glIsEnabled(GL_DEPTH_TEST),
+             gles_glIsEnabled(GL_SCISSOR_TEST), scissor[0], scissor[1],
+             scissor[2], scissor[3], viewport[0], viewport[1], viewport[2],
+             viewport[3]);
+    }
+    gles_glDrawArrays(mode, first, count);
+    freecad_sketch_diag_after("glDrawArrays");
+}
+
+static inline void freecad_sketch_diag_draw_elements(
+    const char *file, int line, GLenum mode, GLsizei count, GLenum type,
+    const GLvoid *indices)
+{
+    LOAD_GLES(glDrawElements);
+    freecad_sketch_diag_before("glDrawElements");
+    if (freecad_sketch_diag_budget > 0) {
+        LOAD_GLES(glGetIntegerv);
+        LOAD_GLES(glIsEnabled);
+        GLint program = 0;
+        GLint viewport[4] = {0, 0, 0, 0};
+        GLint scissor[4] = {0, 0, 0, 0};
+        gles_glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+        gles_glGetIntegerv(GL_VIEWPORT, viewport);
+        gles_glGetIntegerv(GL_SCISSOR_BOX, scissor);
+        LOGD("SKETCH_DIAG draw-elements %s:%d mode=0x%04x count=%d type=0x%04x "
+             "indices=%p program=%d blend=%d depth=%d scissor=%d "
+             "box=%d,%d,%d,%d viewport=%d,%d,%d,%d\n",
+             file, line, mode, count, type, indices, program,
+             gles_glIsEnabled(GL_BLEND), gles_glIsEnabled(GL_DEPTH_TEST),
+             gles_glIsEnabled(GL_SCISSOR_TEST), scissor[0], scissor[1],
+             scissor[2], scissor[3], viewport[0], viewport[1], viewport[2],
+             viewport[3]);
+    }
+    gles_glDrawElements(mode, count, type, indices);
+    freecad_sketch_diag_after("glDrawElements");
+}
+
+#define FREECAD_SKETCH_DIAG_TEX_IMAGE2D(...) \
+    freecad_sketch_diag_tex_image2d(__FILE__, __LINE__, __VA_ARGS__)
+#define FREECAD_SKETCH_DIAG_TEX_SUB_IMAGE2D(...) \
+    freecad_sketch_diag_tex_sub_image2d(__FILE__, __LINE__, __VA_ARGS__)
+#define FREECAD_SKETCH_DIAG_DRAW_ARRAYS(...) \
+    freecad_sketch_diag_draw_arrays(__FILE__, __LINE__, __VA_ARGS__)
+#define FREECAD_SKETCH_DIAG_DRAW_ELEMENTS(...) \
+    freecad_sketch_diag_draw_elements(__FILE__, __LINE__, __VA_ARGS__)
+
+static inline void freecad_sketch_diag_gles_string(const char *site,
+                                                   GLenum name)
+{
+    if (freecad_sketch_diag_budget == 0)
+        return;
+    LOAD_GLES(glGetString);
+    const GLubyte *value = gles_glGetString(name);
+    LOGD("SKETCH_DIAG string %s name=0x%04x value=%s\n", site, name,
+         value ? (const char *)value : "(null)");
+    --freecad_sketch_diag_budget;
+}
+
+#else
+
+#define freecad_sketch_diag_before(site) ((void)0)
+#define freecad_sketch_diag_after(site) ((void)0)
+#define freecad_sketch_diag_state(site, a, b, c, d) ((void)0)
+#define freecad_sketch_diag_gles_string(site, name) ((void)0)
+
+#endif
+
+#endif
