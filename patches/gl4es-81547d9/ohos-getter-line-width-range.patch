         case GL_POINT_DISTANCE_ATTENUATION :
             memcpy(params, glstate->pointsprite.distance, 3*sizeof(GLfloat));
             break;
+        case GL_LINE_WIDTH_RANGE:
+            // GL_LINE_WIDTH_RANGE (0x0B22) is GL1-only; on GLES2 the native
