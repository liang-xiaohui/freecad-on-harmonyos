+            // SoGLLineWidthElement clamp widths using garbage values.
+            gles_glGetFloatv(GL_ALIASED_LINE_WIDTH_RANGE, params);
+            break;
+        case GL_LINE_WIDTH_GRANULARITY:
+            // Not queryable on GLES2; report the coarsest safe value.
+            params[0] = 1.0f;
+            break;
         case GL_DEPTH_RANGE:
             params[0] = glstate->depth.Near;
