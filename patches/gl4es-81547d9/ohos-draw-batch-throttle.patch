+static void ohos_flush_pending_draws(void) {
+    if(!glstate->ohos_pending_draw_count)
+        return;
+
+    LOAD_GLES(glFlush);
+    gles_glFlush();
+    glstate->ohos_pending_draw_count = 0;
+}
+
+static void ohos_throttle_after_draw(void) {
+    if(++glstate->ohos_pending_draw_count >= OHOS_DRAW_BATCH_LIMIT)
+        ohos_flush_pending_draws();
+}
+#else
+static void ohos_throttle_after_draw(void) {}
+#endif
