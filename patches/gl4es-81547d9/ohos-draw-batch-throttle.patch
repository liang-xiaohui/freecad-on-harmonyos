+static unsigned int freecad_material_diag_budget = 96;
+static unsigned int freecad_material_diag_baseline = 12;
+
+static int freecad_material_diag_colors(GLint first, GLsizei count,
+                                        GLenum index_type, const void *indices,
+                                        GLfloat *min_color, GLfloat *max_color,
+                                        unsigned int *sample_count)
+{
+    vertexattrib_t *color = &glstate->vao->vertexattrib[ATT_COLOR];
+    for (int component = 0; component < 4; ++component) {
+        min_color[component] = 1.0f;
+        max_color[component] = 0.0f;
+    }
+    *sample_count = 0;
+    if (!color->enabled || color->size < 4 || color->stride < 0 ||
+        (color->type != GL_FLOAT && color->type != GL_UNSIGNED_BYTE))
+        return 0;
+
+    const size_t offset = (size_t)(uintptr_t)color->pointer;
+    const size_t component_size = color->type == GL_FLOAT ? sizeof(GLfloat) : 1;
+    const size_t stride = color->stride ? (size_t)color->stride
+                                        : (size_t)color->size * component_size;
+    const unsigned char *base;
+    if (color->buffer && color->buffer->data) {
+        if (offset + 4 * component_size > (size_t)color->buffer->size ||
+            stride < 4 * component_size)
+            return 0;
+        base = (const unsigned char *)color->buffer->data + offset;
+    }
+    else {
+        if (!color->pointer || stride < 4 * component_size)
+            return 0;
+        base = (const unsigned char *)color->pointer;
+    }
+    if (!base)
+        return 0;
+
+    const size_t step = count > 512 ? (size_t)count / 512 : 1;
+    for (size_t element = 0; element < (size_t)count; element += step) {
+        size_t vertex;
+        if (!index_type) {
+            vertex = (size_t)first + element;
+        }
+        else if (index_type == GL_UNSIGNED_INT) {
+            vertex = ((const GLuint *)indices)[element];
+        }
+        else if (index_type == GL_UNSIGNED_SHORT) {
+            vertex = ((const GLushort *)indices)[element];
+        }
+        else {
+            return 0;
+        }
+        if (color->buffer &&
+            offset + vertex * stride + 4 * component_size > (size_t)color->buffer->size)
+            continue;
+        for (int component = 0; component < 4; ++component) {
+            GLfloat value;
+            if (color->type == GL_FLOAT) {
+                memcpy(&value, base + vertex * stride + component * sizeof(GLfloat), sizeof(value));
+            }
+            else {
+                value = base[vertex * stride + component] / 255.0f;
+            }
+            if (value < min_color[component]) min_color[component] = value;
+            if (value > max_color[component]) max_color[component] = value;
+        }
+        ++*sample_count;
+    }
+    return *sample_count && min_color[3] < 0.999f;
+}
+
+static void freecad_material_diag_draw(const char *kind, GLenum mode, GLint first,
+                                       GLsizei count, GLenum index_type,
+                                       const void *indices)
+{
+    if (!freecad_material_diag_budget || mode != GL_TRIANGLES)
+        return;
+
+    GLfloat min_color[4], max_color[4];
+    unsigned int samples;
+    const int has_alpha = freecad_material_diag_colors(
+        first, count, index_type, indices, min_color, max_color, &samples);
+    const int interesting = has_alpha || glstate->enable.blend || !glstate->depth.mask;
+    if (!interesting && (!freecad_material_diag_baseline || count < 300))
+        return;
+    if (!interesting)
+        --freecad_material_diag_baseline;
+
+    LOAD_GLES(glGetIntegerv);
+    LOAD_GLES(glIsEnabled);
+    LOAD_GLES2(glGetVertexAttribiv);
+    LOAD_GLES2(glGetVertexAttribPointerv);
+    GLint native_depth_mask = -1;
+    GLint native_program = -1;
+    GLint native_array_buffer = -1;
+    GLint native_element_buffer = -1;
+    gles_glGetIntegerv(GL_DEPTH_WRITEMASK, &native_depth_mask);
+    gles_glGetIntegerv(GL_CURRENT_PROGRAM, &native_program);
+    gles_glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &native_array_buffer);
+    gles_glGetIntegerv(GL_ELEMENT_ARRAY_BUFFER_BINDING, &native_element_buffer);
+    vertexattrib_t *color = &glstate->vao->vertexattrib[ATT_COLOR];
+    GLint native_color[5] = {-1, -1, -1, -1, -1};
+    GLint native_normal[5] = {-1, -1, -1, -1, -1};
+    void *native_color_pointer = NULL;
+    void *native_normal_pointer = NULL;
+    if (gles_glGetVertexAttribiv && gles_glGetVertexAttribPointerv) {
+        gles_glGetVertexAttribiv(ATT_COLOR, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &native_color[0]);
+        gles_glGetVertexAttribiv(ATT_COLOR, GL_VERTEX_ATTRIB_ARRAY_SIZE, &native_color[1]);
+        gles_glGetVertexAttribiv(ATT_COLOR, GL_VERTEX_ATTRIB_ARRAY_TYPE, &native_color[2]);
+        gles_glGetVertexAttribiv(ATT_COLOR, GL_VERTEX_ATTRIB_ARRAY_NORMALIZED, &native_color[3]);
+        gles_glGetVertexAttribiv(ATT_COLOR, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &native_color[4]);
+        gles_glGetVertexAttribPointerv(ATT_COLOR, GL_VERTEX_ATTRIB_ARRAY_POINTER,
+                                      &native_color_pointer);
+        gles_glGetVertexAttribiv(ATT_NORMAL, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &native_normal[0]);
+        gles_glGetVertexAttribiv(ATT_NORMAL, GL_VERTEX_ATTRIB_ARRAY_SIZE, &native_normal[1]);
+        gles_glGetVertexAttribiv(ATT_NORMAL, GL_VERTEX_ATTRIB_ARRAY_TYPE, &native_normal[2]);
+        gles_glGetVertexAttribiv(ATT_NORMAL, GL_VERTEX_ATTRIB_ARRAY_NORMALIZED, &native_normal[3]);
+        gles_glGetVertexAttribiv(ATT_NORMAL, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &native_normal[4]);
+        gles_glGetVertexAttribPointerv(ATT_NORMAL, GL_VERTEX_ATTRIB_ARRAY_POINTER,
+                                      &native_normal_pointer);
+    }
+    --freecad_material_diag_budget;
+    LOGD("MATERIAL_DIAG %s count=%d rgba=%.3f..%.3f,%.3f..%.3f,%.3f..%.3f,%.3f..%.3f samples=%u "
+         "color={enabled=%d size=%d type=0x%04x stride=%d ptr=%p rptr=%p norm=%d buffer=%u real=%u bytes=%d} "
+         "blend=%d/%d factors=0x%04x,0x%04x depthmask=%d/%d depth=%d/%d "
+         "lighting=%d colmat=%d cmmode=%d/%d matalpha=%.3f coloralpha=%.3f program=%d "
+         "nativebuf=%d/%d nativecolor={enabled=%d size=%d type=0x%04x norm=%d buffer=%d ptr=%p} "
+         "nativenormal={enabled=%d size=%d type=0x%04x norm=%d buffer=%d ptr=%p}\n",
+         kind, count,
+         min_color[0], max_color[0], min_color[1], max_color[1],
+         min_color[2], max_color[2], min_color[3], max_color[3], samples,
+         color->enabled, color->size, color->type, color->stride,
+         color->pointer, color->real_pointer, color->normalized,
+         color->buffer ? color->buffer->buffer : 0,
+         color->buffer ? color->buffer->real_buffer : 0,
+         color->buffer ? (int)color->buffer->size : 0,
+         glstate->enable.blend, gles_glIsEnabled(GL_BLEND),
+         glstate->blendsfactorrgb, glstate->blenddfactorrgb,
+         glstate->depth.mask, native_depth_mask,
+         glstate->enable.depth_test, gles_glIsEnabled(GL_DEPTH_TEST),
+         glstate->fpe_state ? glstate->fpe_state->lighting : -1,
+         glstate->fpe_state ? glstate->fpe_state->color_material : -1,
+         glstate->fpe_state ? glstate->fpe_state->cm_front_mode : -1,
+         glstate->fpe_state ? glstate->fpe_state->cm_back_mode : -1,
+         glstate->material.front.diffuse[3], glstate->color[3], native_program,
+         native_array_buffer, native_element_buffer,
+         native_color[0], native_color[1], native_color[2], native_color[3],
+         native_color[4], native_color_pointer,
+         native_normal[0], native_normal[1], native_normal[2], native_normal[3],
+         native_normal[4], native_normal_pointer);
+}
