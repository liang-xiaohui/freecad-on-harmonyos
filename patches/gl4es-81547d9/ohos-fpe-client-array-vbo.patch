 typedef struct scratch_s {
     void*       scratch[16];
     int         size;
+    // Converted attribute data is uploaded into short-lived GLES buffers.
+    // Buffer object lifetime is managed by the driver, so freeing these after
+    // the draw does not require a CPU/GPU glFinish fence.
+    GLuint      vbo[16];
+    int         vbo_size;
 } scratch_t;
 void free_scratch(scratch_t* scratch);
 
--- a/src/gl/fpe.c
+++ b/src/gl/fpe.c
@@ -224,9 +224,41 @@
 }
 #endif
 
+static GLuint upload_bgra_scratch(scratch_t *scratch, const void *ptr,
+                                  GLint stride, GLsizei count) {
+    if (!ptr || count <= 0 || scratch->vbo_size >= 16)
+        return 0;
+
+    // GLES2 does not accept GL_BGRA vertex attributes. Convert once on the
+    // CPU, then hand ownership of the converted bytes to a GLES buffer. The
+    // driver keeps a deleted buffer alive while a queued draw references it.
+    GLvoid *converted = copy_gl_pointer_color_bgra(ptr, stride, 4, 0, count);
+    if (!converted)
+        return 0;
+
+    GLuint buffer = 0;
+    LOAD_GLES(glGenBuffers);
+    LOAD_GLES(glBufferData);
+    if (gles_glGenBuffers)
+        gles_glGenBuffers(1, &buffer);
+    if (!buffer || !gles_glBufferData) {
+        free(converted);
+        return 0;
+    }
+    bindBuffer(GL_ARRAY_BUFFER, buffer);
+    gles_glBufferData(GL_ARRAY_BUFFER,
+                      (GLsizeiptr)count * 4 * (GLsizeiptr)sizeof(GLfloat),
+                      converted, GL_STREAM_DRAW);
+    free(converted);
+    scratch->vbo[scratch->vbo_size++] = buffer;
+    return buffer;
+}
+
 void free_scratch(scratch_t* scratch) {
     for(int i=0; i<scratch->size; ++i)
         free(scratch->scratch[i]);
+    for(int i=0; i<scratch->vbo_size; ++i)
+        deleteSingleBuffer(scratch->vbo[i]);
 }
 
