--- a/src/gl/fpe.c
+++ b/src/gl/fpe.c
@@ -39,6 +39,15 @@
 #endif
 
 void free_scratch(scratch_t* scratch) {
+#if defined(__OHOS__)
+    if(scratch->size) {
+        // Zink on HarmonyOS can return before it has consumed client attribute
+        // memory. Keep GL4ES' converted arrays alive until this draw completes.
+        LOAD_GLES(glFinish);
+        gles_glFinish();
+
+    }
+#endif
     for(int i=0; i<scratch->size; ++i)
         free(scratch->scratch[i]);
 }
