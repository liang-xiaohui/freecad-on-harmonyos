diff --git a/cMake/FreeCAD_Helpers/SetupQt.cmake b/cMake/FreeCAD_Helpers/SetupQt.cmake
--- a/cMake/FreeCAD_Helpers/SetupQt.cmake
+++ b/cMake/FreeCAD_Helpers/SetupQt.cmake
@@ -20,6 +20,20 @@ if(BUILD_GUI)
     endif()
 
-    list (APPEND FREECAD_QT_COMPONENTS OpenGL PrintSupport Svg UiTools Widgets LinguistTools)
+    list (APPEND FREECAD_QT_COMPONENTS OpenGL PrintSupport Svg Widgets)
+    if (CMAKE_SYSTEM_NAME STREQUAL "OHOS" AND FREECAD_QT_MAJOR_VERSION EQUAL 6)
+        # Link the target UiTools library by file path. Consuming the imported
+        # target would add QT_UITOOLS_LIB and its include directory to every
+        # FreeCADGui translation unit, needlessly forcing a full GUI rebuild.
+        # LinguistTools supplies the executable host-side lrelease target used
+        # to compile the translations embedded into the target libraries.
+        find_package(Qt6 REQUIRED COMPONENTS UiTools LinguistTools)
+        get_target_property(QtUiTools_LIBRARIES Qt6::UiTools IMPORTED_LOCATION_RELEASE)
+        set(QtUiTools_INCLUDE_DIRS "")
+        set(QtUiTools_FOUND ${Qt6UiTools_FOUND})
+        set(QtUiTools_VERSION ${Qt6UiTools_VERSION})
+    else()
+        list (APPEND FREECAD_QT_COMPONENTS UiTools LinguistTools)
+    endif()
 
     if(BUILD_DESIGNER_PLUGIN)
         list (APPEND FREECAD_QT_COMPONENTS Designer)
