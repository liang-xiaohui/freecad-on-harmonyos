+        // the mangled type name, which provides the same type safety, so store
+        // a plain void* instead.
+        void* instance;
 
         template<typename T>
         T* get() const
         {
-            return std::any_cast<T*>(instance);
+            return static_cast<T*>(instance);
         }
     };
 
