 {
     ZoneScoped;
 
+    QOpenGLWidget* w = static_cast<QOpenGLWidget*>(this->viewport());
+#if defined(FREECAD_OHOS)
+    constexpr auto surfaceReadyProperty = "_freecad_ohos_surface_ready";
+    constexpr auto surfaceTimerProperty = "_freecad_ohos_surface_timer_started";
+    // ArkUI registers and sizes a new XComponent asynchronously. Block every
+    // first-frame paint until that work has had time to complete.
+    if (!w->property(surfaceReadyProperty).toBool()) {
+        if (!w->property(surfaceTimerProperty).toBool()) {
+            w->setProperty(surfaceTimerProperty, true);
+            QTimer::singleShot(250, w, [w]() {
+                w->setProperty(surfaceReadyProperty, true);
+                w->update();
+            });
+        }
+        return;
+    }
+#endif
+
+    const auto deferPaintUntilContextIsReady = [w]() {
+        QTimer::singleShot(16, w, [w]() { w->update(); });
+    };
+    const auto makeContextCurrent = [w]() {
+        if (!w->isValid() || !w->context()) {
+            return false;
+        }
+
+        w->makeCurrent();
+        if (QOpenGLContext::currentContext() != w->context()) {
+            return false;
+        }
+#if defined(FREECAD_OHOS)
+        // Before an OHOS XComponent surface exists, Qt can make the context
+        // current on the 1x1 startup pbuffer. GL4ES cannot render there.
+        if (eglGetCurrentContext() == EGL_NO_CONTEXT) {
+            return false;
+        }
+        const EGLDisplay display = eglGetCurrentDisplay();
+        const EGLSurface surface = eglGetCurrentSurface(EGL_DRAW);
+        if (display == EGL_NO_DISPLAY || surface == EGL_NO_SURFACE) {
+            return false;
+        }
+        EGLint surfaceWidth = 0;
+        EGLint surfaceHeight = 0;
+        if (eglQuerySurface(display, surface, EGL_WIDTH, &surfaceWidth) != EGL_TRUE
+            || eglQuerySurface(display, surface, EGL_HEIGHT, &surfaceHeight) != EGL_TRUE
+            || surfaceWidth <= 1 || surfaceHeight <= 1) {
+            return false;
+        }
+#endif
+        return true;
+    };
+
+    // Coin and GL4ES both issue GL calls during render-manager setup, so the
+    // context must be current before any initialization or activation below.
+    if (!makeContextCurrent()) {
+        qWarning() << "No current GL context found; deferring Quarter paint";
+        deferPaintUntilContextIsReady();
+        return;
+    }
+
     if (updateDevicePixelRatio()) {
