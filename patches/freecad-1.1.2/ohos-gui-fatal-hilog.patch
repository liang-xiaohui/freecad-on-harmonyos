+#if defined(FREECAD_OHOS)
+// OHOS: Base::Console output is invisible in hilog, so mirror critical/fatal
+// Qt messages (e.g. QPA qFatal) there before the deliberate abort.
+static void ohosLogCriticalToHilog(const char* text)
+{
+    using OhLogPrintFn = int (*)(int, int, unsigned int, const char*, const char*, ...);
+    static OhLogPrintFn ohLogPrint = []() -> OhLogPrintFn {
+        void* handle = dlopen("libhilog_ndk.z.so", RTLD_NOW | RTLD_LOCAL);
+        return handle ? reinterpret_cast<OhLogPrintFn>(dlsym(handle, "OH_LOG_Print")) : nullptr;
+    }();
+    if (ohLogPrint) {
+        ohLogPrint(0, 6, 0xFC00, "FreeCADProbe", "%{public}s", text);  // LOG_APP, LOG_FATAL
+    }
+}
+#endif
