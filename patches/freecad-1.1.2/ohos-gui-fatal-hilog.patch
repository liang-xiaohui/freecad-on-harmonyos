+#if defined(FREECAD_OHOS)
+// OHOS: Base::Console output is invisible in hilog, so mirror warning-level and
+// above Qt messages (QPA warnings, GL capability reports such as the depth
+// attachment format, ...) there. Fatal messages are mirrored before the abort.
+static void ohosLogQtMessageToHilog(int priority, const char* text)
+{
+    using OhLogPrintFn = int (*)(int, int, unsigned int, const char*, const char*, ...);
+    static OhLogPrintFn ohLogPrint = []() -> OhLogPrintFn {
+        void* handle = dlopen("libhilog_ndk.z.so", RTLD_NOW | RTLD_LOCAL);
+        return handle ? reinterpret_cast<OhLogPrintFn>(dlsym(handle, "OH_LOG_Print")) : nullptr;
+    }();
+    if (ohLogPrint) {
+        ohLogPrint(0, priority, 0xFC00, "FreeCADProbe", "%{public}s", text);  // LOG_APP
+    }
+}
+#endif
