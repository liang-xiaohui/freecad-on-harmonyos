{
  "app": {
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "26.0.0(26)",
        "targetSdkVersion": "26.0.0(26)",
        "runtimeOS": "HarmonyOS",
        "signingConfig": "default"
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ],
    "signingConfigs": [
      {
        "name": "default",
        "material": {
          "storePassword": "REPLACE_LOCALLY",
          "certpath": "/absolute/path/to/debug.cer",
          "keyAlias": "debugKey",
          "keyPassword": "REPLACE_LOCALLY",
          "profile": "/absolute/path/to/debug.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/absolute/path/to/debug.p12"
        },
        "type": "HarmonyOS"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
